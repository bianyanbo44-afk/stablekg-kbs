# Raw archives and extracted benchmark data are downloaded from the manifest.
data/raw/*.zip
data/raw/*_all/*.jsonl

# Large model checkpoints are reproducible artifacts, not source files.
results_neural/*.pt

# Local smoke outputs and LaTeX build files.
*_smoke/
neural_tune/
neural_smoke/
chronological_smoke/
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
__pycache__/
*.pyc

# Local GPU environment, large recent-backbone weights and dense score caches.
.venv-gpu/
results_recent*/**/*.pt
results_recent*/**/*.npy
results_recent*/**/*_predictions.csv
results_review_20260909/*_features.csv
results_review_20260909/*_predictions.csv
data/processed_recent/
tmp/

# External research checkouts are reproducible from their pinned upstream URLs.
external/*
!external/README.md

